@dataclass
class SymbolState:
    last_alert_ts: float = 0.0

class Scanner:
    def __init__(self):
        log("[INIT] Hammer Pro+ (DYNAMIC) Başlatılıyor...")
        self.ex = ccxt_async.binanceusdm({
            "apiKey": BINANCE_API_KEY,
